{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["bun"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["server.ts", "gate.ts", "plugin-lock.ts", "zerokun/*.ts"],
  "exclude": ["**/*.test.ts"]
}
