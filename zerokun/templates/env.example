# Slack アプリのトークンを貼る（前後にスペースや引用符は付けない。貼ったら保存）
SLACK_BOT_TOKEN=xoxb-ここに貼る
SLACK_APP_TOKEN=xapp-ここに貼る

# 任意: watchdog通知先（未指定ならaccess.jsonのallowFrom先頭）と再通知間隔（分）
# ZEROKUN_WATCHDOG_NOTIFY=U0123456789
# ZEROKUN_WATCHDOG_REALERT_MIN=60

# 任意: bridge起動時に回収する履歴の時間窓とチャンネルごとの最大件数
# ZEROKUN_CATCHUP_WINDOW_H=48
# ZEROKUN_CATCHUP_LIMIT=20
